---
import Layout from "../layouts/Layout.astro"
import type { PriceRow } from "../db/queries.js"
import { buildProducts, buildChartData } from "./_data.js"
import type { ProductSummary } from "./_data.js"
import ProductCard from "./_ProductCard.astro"
import PriceChart from "./_PriceChart.astro"

process.env.TURSO_DATABASE_URL ??= import.meta.env.TURSO_DATABASE_URL
process.env.TURSO_AUTH_TOKEN ??= import.meta.env.TURSO_AUTH_TOKEN

let allPoints: PriceRow[] = []
let products: ProductSummary[] = []
let chartError: string | null = null

try {
  const { getAllSnapshots } = await import("../db/queries.js")
  allPoints = await getAllSnapshots()
  products = buildProducts(allPoints)
} catch (error) {
  chartError = error instanceof Error ? error.message : "Error de conexion"
}

const chart = buildChartData(allPoints, products)
const uniqueDays = [...new Set(allPoints.map((p) => p.scrapedAt.slice(0, 10)))]
---

<Layout>
  <main class="page">
    <header class="top">
      <h1>Price Tracker</h1>
      {products.length > 0 && (
        <p class="meta">
          {products.length} productos · {allPoints.length} registros · {uniqueDays.length} dias
        </p>
      )}
    </header>

    {chartError ? (
      <div class="notice">{chartError}</div>
    ) : (
      <>
        <section class="cards">
          {products.map((p) => (
            <ProductCard product={p} color={chart.colorMap.get(p.asin)!} />
          ))}
        </section>
        <PriceChart {...chart} />
      </>
    )}
  </main>
</Layout>

<style>
  * { box-sizing: border-box; }

  .page {
    max-width: 960px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
    color: #e4e4e7;
    font-family: system-ui, -apple-system, sans-serif;
    min-height: 100vh;
  }

  .top { margin-bottom: 2rem; }

  h1 {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0;
    color: #fafafa;
    letter-spacing: -0.02em;
  }

  .meta {
    margin: 0.25rem 0 0;
    font-size: 0.8rem;
    color: #71717a;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .notice {
    padding: 1.5rem;
    border: 1px dashed #27272a;
    border-radius: 8px;
    color: #71717a;
    text-align: center;
    font-size: 0.9rem;
  }

  @media (max-width: 640px) {
    .cards { grid-template-columns: 1fr; }
  }
</style>
