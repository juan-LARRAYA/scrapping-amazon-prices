---
import Layout from "../layouts/Layout.astro"
import type { PriceRow } from "../db/queries.js"
import { buildProducts, buildChartData, STORE_LABELS } from "./_data.js"
import type { ProductSummary, Store } from "./_data.js"
import ProductCard from "./_ProductCard.astro"
import PriceChart from "./_PriceChart.astro"

process.env.TURSO_DATABASE_URL ??= import.meta.env.TURSO_DATABASE_URL
process.env.TURSO_AUTH_TOKEN ??= import.meta.env.TURSO_AUTH_TOKEN

let allPoints: PriceRow[] = []
let products: ProductSummary[] = []
let chartError: string | null = null

try {
  const { getAllSnapshots } = await import("../db/queries.js")
  allPoints = await getAllSnapshots()
  products = buildProducts(allPoints)
} catch (error) {
  chartError = error instanceof Error ? error.message : "Error de conexion"
}

const chart = buildChartData(allPoints, products)
const uniqueDays = [...new Set(allPoints.map((p) => p.scrapedAt.slice(0, 10)))]

const STORE_ORDER: Store[] = ["amazon-es", "amazon-us", "mercadolibre", "unknown"]
const productsByStore = STORE_ORDER
  .map((store) => ({ store, items: products.filter((p) => p.store === store) }))
  .filter(({ items }) => items.length > 0)
---

<Layout>
  <main class="page">
    <header class="top">
      <h1>Price Tracker</h1>
      {products.length > 0 && (
        <p class="meta">
          {products.length} productos · {allPoints.length} registros · {uniqueDays.length} dias
        </p>
      )}
    </header>

    {chartError ? (
      <div class="notice">{chartError}</div>
    ) : (
      <>
        {productsByStore.map(({ store, items }) => (
          <details class="store-section" open>
            <summary class="store-label">
              {STORE_LABELS[store]}
              <span class="count">{items.length}</span>
            </summary>
            <div class="cards">
              {items.map((p) => (
                <ProductCard product={p} color={chart.colorMap.get(p.asin)!} />
              ))}
            </div>
          </details>
        ))}
        <PriceChart series={chart.series} />
      </>
    )}
  </main>
</Layout>

<style>
  * { box-sizing: border-box; }

  .page {
    max-width: 960px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
    color: #e4e4e7;
    font-family: system-ui, -apple-system, sans-serif;
    min-height: 100vh;
  }

  .top { margin-bottom: 2rem; }

  h1 {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0;
    color: #fafafa;
    letter-spacing: -0.02em;
  }

  .meta {
    margin: 0.25rem 0 0;
    font-size: 0.8rem;
    color: #71717a;
  }

  /* Collapsible store sections */
  .store-section {
    margin-bottom: 1.25rem;
  }

  .store-label {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #52525b;
    margin-bottom: 0.6rem;
    cursor: pointer;
    user-select: none;
    width: fit-content;
  }

  .store-label::-webkit-details-marker { display: none; }

  .store-label::before {
    content: "▾";
    display: inline-block;
    font-size: 1.1rem;
    line-height: 1;
    transition: transform 150ms ease;
    color: #71717a;
  }

  .store-section:not([open]) .store-label::before {
    transform: rotate(-90deg);
  }

  .count {
    background: #27272a;
    color: #71717a;
    font-size: 0.6rem;
    padding: 0.1rem 0.35rem;
    border-radius: 999px;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 0.75rem;
    padding-bottom: 0.25rem;
  }

  .notice {
    padding: 1.5rem;
    border: 1px dashed #27272a;
    border-radius: 8px;
    color: #71717a;
    text-align: center;
    font-size: 0.9rem;
  }

  @media (max-width: 640px) {
    .cards { grid-template-columns: 1fr; }
  }
</style>
