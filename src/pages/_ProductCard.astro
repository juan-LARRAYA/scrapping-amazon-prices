---
import { fmt, delta } from "./_data.js"
import type { ProductSummary } from "./_data.js"

interface Props {
  product: ProductSummary
  color: string
}

const { product: p, color } = Astro.props
const d = delta(p.latestPrice, p.previousPrice)
---

<article class="card">
  <div class="card-top">
    <span class="dot" style={`background:${color}`} />
    <span class="asin">{p.asin}</span>
    {p.rating != null && <span class="rating">★ {p.rating.toFixed(1)}</span>}
  </div>

  {p.title && (
    <h3 class="title">
      {p.url
        ? <a href={p.url} target="_blank" rel="noopener noreferrer">{p.title}</a>
        : p.title}
    </h3>
  )}

  <div class="price-line">
    <span class="price">{p.latestPrice != null ? fmt(p.latestPrice, p.currency) : "—"}</span>
    {d != null && (
      <span class={`delta ${d > 0 ? "up" : d < 0 ? "down" : ""}`}>
        {d > 0 ? "+" : ""}{d.toFixed(1)}%
      </span>
    )}
  </div>

  <div class="range">
    <span>{fmt(p.minPrice, p.currency)}</span>
    <span class="range-bar"><span class="range-fill" style={`background:${color}`} /></span>
    <span>{fmt(p.maxPrice, p.currency)}</span>
  </div>
</article>

<style>
  .card {
    background: #18181b;
    border: 1px solid #27272a;
    border-radius: 10px;
    padding: 1rem;
  }

  .card-top {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.5rem;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
    display: inline-block;
  }

  .asin {
    font-size: 0.7rem;
    color: #52525b;
    font-family: ui-monospace, monospace;
    letter-spacing: 0.03em;
  }

  .rating {
    margin-left: auto;
    font-size: 0.7rem;
    color: #a1a1aa;
  }

  .title {
    font-size: 0.85rem;
    font-weight: 400;
    margin: 0 0 0.6rem;
    line-height: 1.4;
    color: #a1a1aa;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .title a {
    color: inherit;
    text-decoration: none;
  }
  .title a:hover {
    color: #e4e4e7;
  }

  .price-line {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
  }

  .price {
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #fafafa;
  }

  .delta {
    font-size: 0.75rem;
    font-weight: 500;
    color: #71717a;
  }
  .delta.up { color: #ef4444; }
  .delta.down { color: #22c55e; }

  .range {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.7rem;
    color: #52525b;
  }

  .range-bar {
    flex: 1;
    height: 2px;
    background: #27272a;
    border-radius: 1px;
    position: relative;
  }

  .range-fill {
    position: absolute;
    inset: 0;
    border-radius: 1px;
    opacity: 0.4;
  }
</style>
